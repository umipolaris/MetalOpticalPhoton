+		G4int iR     = (G4int)((r - fTotalRMin) / binR);
+		G4int iPhi   = (binPhi > 0) ? (G4int)((phi - sphereSPhi)   / binPhi)   : 0;
+		G4int iTheta = (binTheta > 0) ? (G4int)((theta - fTotalSTheta) / binTheta) : 0;
+
+		// Clamp to valid range
+		if (iR < 0) iR = 0;
