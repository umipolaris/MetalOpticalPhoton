+	// MetalOpticalPhoton fix (2026-04-29): auto-shrink parallel-world TsCylinder
+	// envelope to avoid coincident boundary with mass-world. See TsBox.cc for
+	// full mechanism explanation.
+	if (IsParallel()) {
+		const G4double pwAutoShrink = 1.0 * CLHEP::nm;
+		totalRMax -= pwAutoShrink;
